.root {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
}

.textCyan {
    color: rgb(0, 245, 255);
    -unity-font-style: bold;
}

.textMagenta {
    color: rgb(255, 0, 170);
    -unity-font-style: bold;
}

.textWhite {
    color: rgb(255, 255, 255);
}

.textDanger {
    color: rgb(255, 0, 51);
    -unity-font-style: bold;
}

.textScore {
    font-size: 42px;
    color: rgb(0, 245, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.textMultiplier {
    font-size: 22px;
    color: rgb(0, 245, 255);
    -unity-text-align: middle-center;
}

.textHighscore {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.7);
    -unity-text-align: upper-right;
}

.panel {
    position: absolute;
    width: 100%;
    height: 100%;
    display: none;
}

.panelVisible {
    display: flex;
}

.hubTop {
    flex-direction: column;
    align-items: center;
    padding-top: 24px;
}

.hubHighscore {
    position: absolute;
    top: 24px;
    right: 24px;
}

.borderWarning {
    position: absolute;
    width: 100%;
    height: 100%;
    display: none;
    border-left-color: rgb(255, 0, 51);
    border-right-color: rgb(255, 0, 51);
    border-top-color: rgb(255, 0, 51);
    border-bottom-color: rgb(255, 0, 51);
    border-top-width: 6px;
    border-right-width: 6px;
    border-bottom-width: 6px;
    border-left-width: 6px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.borderWarningVisible {
    display: flex;
}

.gameoverOverlay {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.75);
    width: 100%;
    height: 100%;
}

.gameoverTitle {
    font-size: 52px;
    color: rgb(255, 0, 51);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.gameoverStatLabel {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.7);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.gameoverStatValue {
    font-size: 28px;
    color: rgb(0, 245, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.essenceValue {
    color: rgb(255, 0, 170);
}

.btn {
    margin-top: 20px;
    padding-top: 14px;
    padding-right: 40px;
    padding-bottom: 14px;
    padding-left: 40px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    font-size: 18px;
    -unity-font-style: bold;
}

.btnPrimary {
    background-color: rgba(0, 245, 255, 0.15);
    border-left-color: rgb(0, 245, 255);
    border-right-color: rgb(0, 245, 255);
    border-top-color: rgb(0, 245, 255);
    border-bottom-color: rgb(0, 245, 255);
    color: rgb(0, 245, 255);
}

.btnSecondary {
    background-color: rgba(255, 0, 170, 0.15);
    border-left-color: rgb(255, 0, 170);
    border-right-color: rgb(255, 0, 170);
    border-top-color: rgb(255, 0, 170);
    border-bottom-color: rgb(255, 0, 170);
    color: rgb(255, 0, 170);
}

.upgradesContainer {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.88);
    width: 100%;
    height: 100%;
    padding-top: 24px;
    padding-right: 24px;
    padding-bottom: 24px;
    padding-left: 24px;
}

.upgradesTitle {
    font-size: 32px;
    color: rgb(0, 245, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.essenceDisplay {
    font-size: 22px;
    color: rgb(255, 0, 170);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.upgradesGrid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
}

.upgradeCard {
    width: 44%;
    margin-top: 4px;
    margin-right: 4px;
    margin-bottom: 4px;
    margin-left: 4px;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgba(0, 245, 255, 0.4);
    border-right-color: rgba(0, 245, 255, 0.4);
    border-top-color: rgba(0, 245, 255, 0.4);
    border-bottom-color: rgba(0, 245, 255, 0.4);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: rgba(0, 245, 255, 0.05);
    flex-direction: column;
    align-items: center;
}

.upgradeCardMaxed {
    border-left-color: rgba(255, 0, 170, 0.4);
    border-right-color: rgba(255, 0, 170, 0.4);
    border-top-color: rgba(255, 0, 170, 0.4);
    border-bottom-color: rgba(255, 0, 170, 0.4);
    background-color: rgba(255, 0, 170, 0.05);
}

.upgradeName {
    font-size: 13px;
    color: rgb(220, 240, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.upgradeEffect {
    font-size: 11px;
    color: rgb(180, 220, 255);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.upgradeLevel {
    font-size: 11px;
    color: rgb(0, 245, 255);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.btnUpgrade {
    padding-top: 6px;
    padding-right: 16px;
    padding-bottom: 6px;
    padding-left: 16px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(0, 245, 255);
    border-right-color: rgb(0, 245, 255);
    border-top-color: rgb(0, 245, 255);
    border-bottom-color: rgb(0, 245, 255);
    background-color: rgba(0, 245, 255, 0.1);
    color: rgb(0, 245, 255);
    font-size: 12px;
}

.btnUpgradeDisabled {
    border-left-color: rgba(255, 255, 255, 0.2);
    border-right-color: rgba(255, 255, 255, 0.2);
    border-top-color: rgba(255, 255, 255, 0.2);
    border-bottom-color: rgba(255, 255, 255, 0.2);
    background-color: rgba(0, 0, 0, 0);
    color: rgba(255, 255, 255, 0.3);
}

.upgradesScroll {
    width: 100%;
    flex-grow: 1;
    margin-bottom: 8px;
}
